# ============================================
# Krishi-Mitra Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!
# ============================================

# Server Port (Render provides this automatically; default 4000 for local dev)
PORT=

# MongoDB Connection String (required)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGO_URI=

# JWT Secret Key (required) - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Frontend URL for CORS (e.g., http://localhost:5500 or https://krishi-mitra.vercel.app)
FRONTEND_ORIGIN=

# Node Environment (development | production)
NODE_ENV=

# DNS Servers for MongoDB SRV resolution (optional, defaults to 8.8.8.8,1.1.1.1)
NODE_DNS_SERVERS=